# ==========================================
# Gemini API Key (Free tier from aistudio.google.com)
# ==========================================
GEMINI_API_KEY="your-gemini-api-key-here"

# ==========================================
# Database (Supabase Free Tier)
# If left empty, pipeline will use local SQLite (data/pipeline.db)
# ==========================================
SUPABASE_URL=""
SUPABASE_KEY=""

# ==========================================
# YouTube OAuth Settings
# ==========================================
# Path to downloaded client secret JSON from Google Cloud Console
YOUTUBE_CLIENT_SECRETS_FILE="client_secret.json"
# OAuth credentials store
YOUTUBE_TOKEN_FILE="token.json"
# For headless GitHub Actions (base64 or json string of token.json):
# YOUTUBE_TOKEN_BASE64=""

# ==========================================
# Pipeline Settings
# ==========================================
DEFAULT_VOICE="en-US-ChristopherNeural"
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
FPS=30

# Supabase Storage bucket for rendered shorts
SUPABASE_BUCKET="shorts"
