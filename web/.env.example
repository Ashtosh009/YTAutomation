# ==========================================
# Vercel / Web Panel Environment Variables
# (Server-side only. Do NOT prefix with NEXT_PUBLIC_)
# ==========================================

# Single-user Panel Authentication
PANEL_PASSWORD="change-this-to-a-secure-password"
SESSION_SECRET="generate-a-random-32-character-secret-string"

# Supabase (Database & Storage)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your-supabase-service-role-or-anon-key"
SUPABASE_BUCKET="shorts"

# GitHub Actions Workflow Dispatch
GITHUB_TOKEN="ghp_yourPersonalAccessTokenWithActionsPermission"
GITHUB_REPO="Ashtosh009/YTAutomation"
